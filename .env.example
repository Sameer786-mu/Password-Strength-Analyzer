# ========================================================
# SecureCheck – Environment Configuration Template
# ========================================================
# Copy this file to .env:
# cp .env.example .env (or copy .env.example .env in Windows)

# Server Port and Host
PORT=3000
HOST=localhost

# Public Site URL
PUBLIC_SITE_URL=http://localhost:3000

# Have I Been Pwned (HIBP) Pwned Passwords Range API
# Uses k-Anonymity (sends 5-char SHA-1 prefix). Free & public, no API key required.
HIBP_API_URL=https://api.pwnedpasswords.com/range/

# API Reference / Documentation URL
HIBP_DOCS_URL=https://haveibeenpwned.com/API/v3#PwnedPasswords

# Environment mode (development / production)
NODE_ENV=development
